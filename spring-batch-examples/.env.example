# ローカル練習用。実AWSの認証情報は設定しない。
BATCH_DB_NAME=cookbook
# 移行先の別名DBを用意済みの場合に指定する。
# BATCH_TARGET_DB_NAME=cookbook
BATCH_DB_USER=cookbook
BATCH_DB_PASSWORD=local-cookbook
BATCH_POSTGRES_PORT=15432
BATCH_TARGET_POSTGRES_PORT=15433
BATCH_S3_PORT=18333
# SeaweedFSのボリューム数。0でディスク空き容量から自動決定する。
BATCH_S3_VOLUME_MAX=0
BATCH_DYNAMO_PORT=18000
BATCH_S3_ACCESS_KEY=localcookbook
BATCH_S3_SECRET_KEY=localcookbooksecret
BATCH_INPUT_BUCKET=batch-input
BATCH_INTERNAL_BUCKET=batch-internal
BATCH_PARTNER_BUCKET=batch-partner
BATCH_DYNAMO_TABLE=batch-customers
BATCH_DYNAMO_OPERATIONS_TABLE=batch-operations
