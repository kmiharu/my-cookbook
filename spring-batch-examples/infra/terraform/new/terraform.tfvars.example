# deletion_protection = false
# skip_final_snapshot = true
# force_destroy_buckets = true
# Add after pushing the image to the root's ECR repository.
# image_uri = "111111111111.dkr.ecr.us-east-1.amazonaws.com/cookbook-batch-sandbox@sha256:<digest>"
